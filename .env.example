# Local dev
# Must be `localhost`, not `127.0.0.1`, and must match the API's CORS_ORIGIN
# host: the session cookie is SameSite=Strict, so `127.0.0.1` and `localhost`
# are different sites to the browser and it will silently drop the cookie.
VITE_API_BASE_URL=http://localhost:3000

# `testnet` (ckt1...) or `mainnet` (ckb1...)
VITE_CKB_NETWORK=testnet

# Explorer links
VITE_CKB_EXPLORER_URL=https://explorer.nervos.org/testnet

# Wallet branding shown in the JoyID request
VITE_WALLET_NAME=CKB Digital Credential
VITE_WALLET_ICON=https://nervos.org/favicon.ico

# Leave empty to use the CCC public endpoints
VITE_CKB_RPC_URL=
